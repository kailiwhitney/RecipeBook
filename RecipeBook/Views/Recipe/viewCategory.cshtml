@{
    string cat = (string?)ViewBag.Category ?? "";
    ViewData["Title"] = cat switch
    {
        "SideDish" => "Side Dishes",
        "MainDish" => "Main Dishes",
        _ when cat.Length > 0 => char.ToUpper(cat[0]) + cat.Substring(1),
        _ => "Recipes"
    };
}
@model List<Recipe>

<div class="section-layout">
    <div class="section-main">
        <div class="mx-5 my-2 border border-secondary border-2 rounded px-4">
            <table class="table">
                <thead>
                    <tr>
                        <th scope="col">Name</th>
                        <th scope="col">Est. Time</th>
                        <th scope="col"># of Ingredients</th>
                        <th scope="col">Difficulty</th>
                        <th scope="col">
                            <!-- Button trigger modal -->
                            <button type="button" class="btn btn-secondary btn-sm" data-bs-toggle="modal" data-bs-target="#addRecipe">
                                Add Recipe
                            </button>
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @foreach(Recipe r in Model){
                        <tr>
                            <th scope="row">@r.Title</th>
                            <td>@(r.PrepTime + r.CookTime) min</td>
                            <td>@r.Ingredients.Count</td>
                            <td>@r.Difficulty</td>
                            <td>
                                <!-- Absolute: from /recipes/{category} a relative
                                     "@r.Id/view" resolves to /recipes/5/view, which
                                     matches no route. -->
                                <a href="/recipe/@r.Id/view">View</a> &ensp;|&ensp;
                                <a href="/recipe/@r.Id/edit">Edit</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <aside class="section-tabs">
        @await Html.PartialAsync("_SectionTabs")
    </aside>
</div>

<!-- Modal -->
<div class="modal fade" id="addRecipe" tabindex="-1" role="dialog" aria-labelledby="addRecipeTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            @await Html.PartialAsync("_AddRecipe")
        </div>
    </div>
</div>
