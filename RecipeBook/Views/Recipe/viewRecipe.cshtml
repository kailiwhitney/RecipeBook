@{
    ViewData["Title"] = @Model.Title;
}
@model Recipe

<a href="/recipes">Back</a>
<h1 class="border-bottom my-3">@Model.Title</h1>

@if (Model.Tags.Count > 0 || Model.Cuisine.Count > 0)
{
    <div class="d-flex flex-wrap gap-1 mb-2">
        @foreach (string c in Model.Cuisine)
        {
            <span class="badge bg-info">@c</span>
        }
        @foreach (string t in Model.Tags)
        {
            <span class="badge rounded-pill p-2 bg-primary">@t</span>
        }
    </div>
}

<div class="d-flex flex-column mx-4">
    <p class="mb-2"><strong>@Model.Calories kcal</strong> per recipe</p>
    <div class="d-flex flex-row">
        <div class="d-flex flex-column me-5">
            <h4 class="border-bottom my-2">Equipment</h4>
            <ul style="list-style-type: none;">
                @foreach(string e in Model.Equipment){
                    <li class="checkbox d-flex flex-row align-items-start">
                            <input type="checkbox" name="packersOff" value="1" class="mt-1 me-3">
                            <label style="width: fit-content;" class="strikethrough">
                                @e
                            </label>
                    </li>
                }
            </ul>
        </div>
    
        <div class="d-flex flex-column">
            <h4 class="border-bottom my-2">Ingredients</h4>
            <ul style="list-style-type: none;">
                @foreach(Ingredient i in Model.Ingredients){
                    <li class="checkbox d-flex flex-row align-items-start">
                            <input type="checkbox" name="packersOff" value="1" class="mt-1 me-3">
                            <label style="width: fit-content;" class="strikethrough">
                                @i.Amount @if(i.Unit != "count"){@i.Unit} of @i.Name
                            </label>
                    </li>
                }
            </ul>
        </div>
    </div>
    
    <h4 class="border-bottom my-2">Directions</h4>
    <ul style="list-style-type: none;">
        @for(int i = 0; i < Model.Directions.Count; i++){
            <li class="checkbox d-flex flex-row align-items-start mb-1">
                    <input type="checkbox" name="packersOff" value="1" class="mt-1 me-3">
                    <label style="width: fit-content;" class="strikethrough">@(i + 1) ) &ensp;@Model.Directions[i]</label>
            </li>
        }
    </ul>
</div>

@* REFERENCE: http://www.java2s.com/example/html-css/html-tag/add-strikethrough-to-checked-checkbox.html *@
<style id="compiled-css" type="text/css">
    input[type=checkbox]:checked + label.strikethrough {
        text-decoration:line-through; <!--from www.java2s.com-->
    }
</style>