@{
    ViewData["Title"] = "Add Recipe";
}
@model Recipe

<h1 class="border-bottom my-3">@Model.Title</h1>
<div class="m-3">
    <form action="update" method="post" id="editForm" class="d-flex flex-column">
        <div class="d-flex flex-row justify-content-between flex-wrap mb-1">
            <div class="d-flex flex-column w-75 mb-2">
                <label asp-for="Title" class="mb-1">Recipe Name </label>
                <input asp-for="Title" value="@Model.Title">
                <span asp-validation-for="Title"></span>
            </div>
            <div class="d-flex flex-column m-2">
                <label class="mb-1">Categories </label>
                @{
                    var allCats = Enum.GetValues(typeof(RecipeCategory)).Cast<RecipeCategory>();
                }
                @foreach (var c in allCats)
                {
                    bool isChecked = Model.Categories.Contains(c);
                    <label class="form-check-label d-inline-flex align-items-center mb-1">
                        <input type="checkbox" name="Categories" value="@c" @(isChecked ? "checked" : "")>
                        <span class="ms-1">@c</span>
                    </label>
                }
            </div>
        </div>
        <div class="d-flex flex-row justify-content-start flex-wrap">
            <div class="d-flex flex-column me-3">
                <div class="d-flex flex-row my-2">
                    <label class="pe-2">Prep. Time (min): </label>
                    <div class="me-3">
                        <input asp-for="PrepTime" type="number" min="0" value="@Model.PrepTime" style="width:80px;">
                        <span asp-validation-for="PrepTime"></span>
                    </div>
                </div>
                <div class="d-flex flex-row">
                    <label class="pe-2">Cook Time (min): </label>
                    <div class="me-3">
                        <input asp-for="CookTime" type="number" min="0" value="@Model.CookTime" style="width:80px;">
                        <span asp-validation-for="CookTime"></span>
                    </div>
                </div>
            </div>
            <div class="d-flex flex-row m-2 align-items-start">
                <label asp-for="Yield" class="pe-2">Yield: </label>
                <input asp-for="Yield" type="number" step="any" value="@Model.Yield">
                <span asp-validation-for="Yield"></span>
            </div>
            <div class="d-flex flex-row m-2 align-items-start">
                <label asp-for="Difficulty" class="pe-2">Difficulty (1-5): </label>
                <input asp-for="Difficulty" type="number" min="1" max="5" value="@Model.Difficulty" style="width:60px;">
                <span asp-validation-for="Difficulty"></span>
            </div>
            <div class="d-flex flex-row m-2 align-items-start">
                <label asp-for="Rating" class="pe-2">Rating (1-5): </label>
                <input asp-for="Rating" type="number" min="1" max="5" value="@Model.Rating" style="width:60px;">
                <span asp-validation-for="Rating"></span>
            </div>
            <div class="d-flex flex-row m-2 align-items-start">
                <label asp-for="Calories" class="pe-2">Calories: </label>
                <input asp-for="Calories" type="number" min="0" value="@Model.Calories" style="width:90px;">
                <span asp-validation-for="Calories"></span>
            </div>
        </div>

        <!-- Equipment list (plain strings, bound to Recipe.Equipment) -->
        <div class="d-flex flex-column my-2">
            <label class="mb-1">Equipment</label>
            @for (int i = 0; i < Model.Equipment.Count; i++)
            {
                <input class="mb-1" type="text" name="Equipment[@i]" value="@Model.Equipment[i]" style="max-width:420px;">
            }
        </div>

        <!-- Directions (ordered plain strings, bound to Recipe.Directions) -->
        <div class="d-flex flex-column my-2">
            <label class="mb-1">Directions</label>
            @for (int i = 0; i < Model.Directions.Count; i++)
            {
                <textarea class="mb-1" name="Directions[@i]" rows="2" style="max-width:640px;">@Model.Directions[i]</textarea>
            }
        </div>

        <!-- Tags / Cuisine: user-extensible "dynamic enums", case-insensitive. -->
        @{ ViewData["Field"] = "Tags"; ViewData["All"] = (List<string>)(ViewBag.AllTags ?? new List<string>()); }
        @await Html.PartialAsync("_TagPicker", Model.Tags)

        @{ ViewData["Field"] = "Cuisine"; ViewData["All"] = (List<string>)(ViewBag.AllCuisine ?? new List<string>()); }
        @await Html.PartialAsync("_TagPicker", Model.Cuisine)
    </form>
    <div class="d-flex flex-row justify-content-around my-3">
        <div class="d-flex flex-column justify-content-around flex-wrap w-50">
            <div class="d-flex flex-column m-2">
                <label style="font-size: x-large;"  class="mb-2">Ingredient List</label>
                <div class="d-flex">
                    @await Html.PartialAsync("../Ingredient/_ViewIngredients", @Model.Ingredients)
                </div>
                <!-- Button trigger modal -->
                <button type="button" class="btn btn-secondary btn-sm my-2" data-bs-toggle="modal" data-bs-target="#addIngredient">
                    Add Ingredient
                </button>
            </div>
        </div>
    </div>
    <div class="d-flex flex-column align-items-end p-1">
        <button type="submit" form="editForm" value="Submit" class="btn btn-primary mb-2 ms-0 w-25">Save Recipe</button>
        <form action="delete" method="post" class="me-2 w-25"><button class="btn btn-danger mx-2 w-100">Delete</button></form>
    </div>
</div>

<!-- Modal -->
<div class="modal" id="addIngredient" tabindex="-1" role="dialog" aria-labelledby="addIngredientTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content d-flex flex-column">
            @await Html.PartialAsync("../Ingredient/_AddIngredient.cshtml")
        </div>
    </div>
</div>