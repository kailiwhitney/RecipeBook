
@model User
<div class="auth-card">
    <h1 class="text-center mb-3">We would love to add your Recipe Book to our Shelves!</h1>
    <form action="register" method="post">
        <div class="field">
            <label asp-for="FirstName">First Name</label>
            <input asp-for="FirstName" autocomplete="given-name" required>
            <span asp-validation-for="FirstName"></span>
        </div>
        <div class="field">
            <label asp-for="LastName">Family Name</label>
            <input asp-for="LastName" autocomplete="family-name" required>
            <span asp-validation-for="LastName"></span>
        </div>
        <div class="field">
            <label asp-for="Username">Username</label>
            <input asp-for="Username" autocomplete="username" required>
            <span asp-validation-for="Username"></span>
        </div>
        <div class="field">
            <label asp-for="Email">Email</label>
            <input asp-for="Email" type="email" autocomplete="email" required>
            <span asp-validation-for="Email"></span>
        </div>
        <div class="field">
            <label asp-for="PhoneNumber">Phone Number (optional)</label>
            <input asp-for="PhoneNumber" type="tel" autocomplete="tel">
            <span asp-validation-for="PhoneNumber"></span>
        </div>
        <div class="field">
            <label asp-for="Password">Password</label>
            <input asp-for="Password" type="password" autocomplete="new-password" required>
            <span asp-validation-for="Password"></span>
        </div>
        <div class="field">
            <label asp-for="ConfirmPW">Password Confirm</label>
            <input asp-for="ConfirmPW" type="password" autocomplete="new-password" required>
            <span asp-validation-for="ConfirmPW"></span>
        </div>
        <button class="btn btn-primary mt-2">Register</button>
    </form>
</div>
