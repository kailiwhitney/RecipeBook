@model List<MealPlan>
<div class="mx-5 my-2 border border-secondary border-2 rounded px-4">
    <table class="table">
        <thead>
            <tr>
            <th scope="col">Name</th>
            <th scope="col">Week Of</th>
            <th scope="col">Number of Meals</th>
            <th scope="col">
                <!-- Button trigger modal -->
                <button type="button" class="btn btn-secondary btn-sm" data-bs-toggle="modal" data-bs-target="#addMP">
                    Add Meal Plan
                </button>
            </th>
            </tr>
        </thead>
        <tbody>
            @foreach(MealPlan m in Model){
            <tr>
                <td>@m.Name</td>
                <td>@m.StartDate.ToString("MM/dd/yyyy")</td>
                <td>@m.Meals.Count</td>
                <td>
                    <a href="/mealplan/@m.Id/edit">Edit</a> |
                    <a href="/mealplan/@m.Id/shoppingList/generate">Shopping List</a>
                </td>
            </tr>
            }
        </tbody>
    </table>
</div>

<!-- Modal -->
<div class="modal fade" id="addMP" tabindex="-1" role="dialog" aria-labelledby="addMealPlanTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content d-flex flex-column">
            @await Html.PartialAsync("_AddMP")
        </div>
    </div>
</div>
