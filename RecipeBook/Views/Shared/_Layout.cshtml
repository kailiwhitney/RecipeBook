<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RecipeBook</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/RecipeBook.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        @if(@Context.Session.GetInt32("uid") != null){
            <h2 class="app-title">@Context.Session.GetString("FamilyName") Family Recipes</h2>
        }      
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>
    @if(@Context.Session.GetInt32("uid") != null){
        <div class="global-actions">
            <a href="/recipes" class="btn btn-primary">Recipe Book</a>
            <a href="/mealplan" class="btn btn-secondary">Plan this week's meals</a>
            <a href="/shoppinglist" class="btn btn-primary">Shopping list</a>
        </div>
    }

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; @DateTime.Now.Year - RecipeBook
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
