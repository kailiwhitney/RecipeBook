@{
    ViewData["Title"]="Shopping List";
}
@model ShoppingList
<h1 class="border-bottom my-3">@Model.Name Shopping List</h1>
<div class="d-flex flex-row m-3">
    <!-- Needed ingredients: aggregated from every linked meal plan -->
    <div class="d-flex flex-column w-75">
        <h4>Needed Ingredients</h4>
        <div class="container-xxl border border-secondary border-2 px-4">
            <ul class="list-group my-3">
                @foreach(IngredientNeed need in Model.NeededIngredients){
                    <li class="list-group-item list-group-item-action d-flex flex-row justify-content-between">
                        @need.Quantity @need.Unit &ensp;|&ensp; @need.Name
                    </li>
                }
            </ul>
        </div>
    </div>
    <!-- Linked plans + estimated cost -->
    <div class="d-flex flex-column ms-4">
        <h4>Meal Plans</h4>
        <ul class="list-group mb-3">
            @foreach(MealPlan mp in Model.MealPlans){
                <li class="list-group-item d-flex flex-row justify-content-between">
                    @mp.Name
                    <form action="/mealplan/@mp.Id/shoppingList/detach" method="post" class="m-0">
                        <button type="submit" class="btn p-0 m-0" style="background-color:transparent">&times;</button>
                    </form>
                </li>
            }
        </ul>
        <p class="mb-1"><strong>Estimated Cost:</strong> @Model.EstimatedCost.ToString("C")</p>
    </div>
</div>
